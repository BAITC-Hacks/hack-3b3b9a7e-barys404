[Unit]
Description=MedFlow web application
Wants=medflow-postgres.service
After=medflow-postgres.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=exec
WorkingDirectory=/home/barys404/apps/medflow-current
EnvironmentFile=/home/barys404/apps/medflow-5ae817c/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/barys404/apps/medflow-current/.venv/bin/python -m uvicorn backend.main:app --host 0.0.0.0 --port 8010 --workers 1 --limit-concurrency 12 --backlog 128 --timeout-keep-alive 5 --timeout-graceful-shutdown 30 --no-access-log --no-server-header
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
UMask=0077

[Install]
WantedBy=default.target
